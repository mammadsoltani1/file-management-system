APP_NAME=FileHub
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://filehub:filehub_dev_password@postgres:5432/filehub

SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/data/uploads

MAX_UPLOAD_SIZE_BYTES=1073741824

REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth/

EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=180
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:8000/verify-email
RESEND_API_URL=https://api.resend.com/emails
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=FileHub
EMAIL_TIMEOUT_SECONDS=15

POSTGRES_DB=filehub
POSTGRES_USER=filehub
POSTGRES_PASSWORD=filehub_dev_password